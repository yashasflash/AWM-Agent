# ==============================================================================
# AWM AGENT — BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public / Anon Key (Safe for client requests)
SUPABASE_KEY=your_supabase_anon_publishable_key_here

# Supabase Secret Service-Role Key (Privileged operations, backend ONLY)
# NEVER EXPOSE TO FRONTEND CODE
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Autonomous n8n AI Decision Engine Webhook
N8N_WEBHOOK_URL=http://localhost:5678/webhook/awm-waste-report

# Initial Authorized Manager Google Emails (comma-separated, auto-normalized)
MANAGER_EMAILS=manager@awm.gov,admin@awm.gov

# Initial Authorized Municipal Staff Google Emails (comma-separated, auto-normalized)
STAFF_EMAILS=staff@awm.gov,staff1@awm.gov,field@awm.gov
