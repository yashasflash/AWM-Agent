# ==============================================================================
# AWM Agent - Backend .gitignore
# ==============================================================================

# Virtual Environments
.venv/
env/
venv/
ENV/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example

# Local Databases & Development Stores
*.db
*.sqlite
*.sqlite3
awm_notifications.db

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Logs
*.log
logs/

# IDE & Editor Specific
.vscode/
.idea/
*.swp
*.swo

# OS Specific
.DS_Store
Thumbs.db