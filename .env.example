# ==============================================================================
# AWM AGENT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Autonomous Waste Management (AWM) Agent Platform
# ==============================================================================
# INSTRUCTIONS:
# 1. Backend uses:  backend/.env
# 2. Frontend uses: frontend/.env
# 3. Copy the respective sections below into backend/.env and frontend/.env.
# 4. NEVER commit your actual .env files or private service keys to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------

# Supabase Project URL (from Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public / Anon Key (Safe for browser/client requests)
SUPABASE_KEY=your_supabase_anon_publishable_key_here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND)
# Used for administrative operations: role assignment, user creation, admin tasks.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Autonomous n8n AI Triage Webhook URL
# By default, points to local n8n instance listening for waste classification
N8N_WEBHOOK_URL=http://localhost:5678/webhook/awm-waste-report

# Designated Operations Manager Google Emails (comma-separated, case-insensitive)
MANAGER_EMAILS=manager@awm.gov,admin@awm.gov

# Designated Municipal Staff Google Emails (comma-separated, case-insensitive)
STAFF_EMAILS=staff@awm.gov,field@awm.gov


# ------------------------------------------------------------------------------
# 2. FRONTEND CONFIGURATION (frontend/.env)
# ------------------------------------------------------------------------------

# Backend FastAPI Gateway URL
VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Supabase Project URL (Client-facing)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Key (Client-facing)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here
